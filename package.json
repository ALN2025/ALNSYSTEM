{
  "name": "aln-system",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "description": "A.L.N SYSTEM — Controle financeiro desktop e mobile offline",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "date-fns": "^4.1.0",
    "expo": "~57.0.16",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-notifications": "~57.0.14",
    "expo-router": "~57.0.16",
    "expo-sharing": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "@types/uuid": "^10.0.0",
    "babel-preset-expo": "^57.0.8",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "typescript": "~6.0.3",
    "wait-on": "^9.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "desktop": "concurrently -k \"expo start --web\" \"wait-on http://localhost:8081 && electron desktop/main.js --dev\"",
    "desktop:prod": "npm run build:web && electron desktop/main.js",
    "desktop:build": "npm run build:web && electron-builder --config electron-builder.json",
    "build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "build:pc": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-pc.ps1",
    "prebuild:android": "expo prebuild --platform android --clean"
  },
  "private": true,
  "build": {
    "appId": "com.alnsystem.meucontrole",
    "productName": "A.L.N SYSTEM"
  }
}
